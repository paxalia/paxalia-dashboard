# MANIFEST.in – include all static assets, templates, and locale files

# Source code
include paxalia/*.py
include paxalia/views/*.py
recursive-include paxalia/logging *.py
include paxalia/templatetags/*.py
recursive-include paxalia/management *.py
recursive-include paxalia/migrations *.py
include paxalia/requirements.txt

# Additional data file
include paxalia/bots_paths.txt

# Templates
recursive-include paxalia/templates *

# Static files (CSS, JS, icons)
recursive-include paxalia/static *

# Translations (source .po files only – .mo is compiled by the user)
include paxalia/locale/en/LC_MESSAGES/django.po
include paxalia/locale/es/LC_MESSAGES/django.po
include paxalia/locale/ar/LC_MESSAGES/django.po
include paxalia/locale/zh-hans/LC_MESSAGES/django.po
include paxalia/locale/pt-br/LC_MESSAGES/django.po

# Exclude what shouldn't be shipped
exclude paxalia/geoip/*.mmdb
global-exclude *.pyc *.pyo __pycache__
global-exclude *.mo